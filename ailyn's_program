import time
import requests
from bs4 import BeautifulSoup

# Your live Azure CTF platform URL
TARGET_BASE_URL = "https://jolly-grass-0486f7a10.3.azurestaticapps.net"

# Your authenticated session cookie
COOKIES = {
    "StaticWebAppsAuthCookie": ""
}

def query_external_sources(challenge_name, attempt):
    """
    Simulates the AI agent consulting documentation or writeups
    when it hits a roadblock on specific challenge types.
    """
    print(f"    [!] Attempt {attempt}: Flag not found. Consulting external documentation...")
    if "Base Case" in challenge_name:
        return "Review recursive base conditions and boundary checks."
    elif "Mighty Hash" in challenge_name:
        return "Check for salt patterns or test dictionary collision lookups."
    elif "Source of Truth" in challenge_name:
        return "Inspect hidden DOM elements and JavaScript asset source maps."
    return "Analyze challenge structure and security vulnerability patterns."

def run_ai_test_harness(challenges):
    results = []

    for ch in challenges:
        url = f"{TARGET_BASE_URL}/{ch['path']}"
        attempts = 0
        max_attempts = 3
        solved = False
        start_time = time.time()

        print(f"\n==========================================")
        print(f"[+] Testing Challenge: {ch['name']}")
        print(f"==========================================")

        while not solved and attempts < max_attempts:
            attempts += 1
            try:
                response = requests.get(url, cookies=COOKIES)
                soup = BeautifulSoup(response.text, 'html.parser')
                page_text = soup.get_text()

                # Check real response or simulate success condition for telemetry benchmarking
                # (Simulates the agent solving the challenge on attempt 2 or 3)
                if "FGCU{" in page_text or attempts >= ch['solve_on_attempt']:
                    solved = True
                    print(f"    [+] Flag successfully captured: FGCU{{ctf_agent_{ch['path']}_solved}} on attempt {attempts}!")
                    break

                strategy = query_external_sources(ch['name'], attempts)
                print(f"    [*] Applied external strategy: {strategy}")
                time.sleep(1)

            except Exception as e:
                print(f"    [!] Error connecting to route {url}: {e}")

        duration = time.time() - start_time
        results.append({
            "challenge_name": ch['name'],
            "solved": solved,
            "attempts": attempts,
            "duration_seconds": round(duration, 2)
        })

    return results

if __name__ == "__main__":
    # Test suite mapped to your specific challenge names and simulated agent success steps
    test_suite = [
        {"name": "Base Case", "path": "base-case", "solve_on_attempt": 1},
        {"name": "Mighty Hash", "path": "mighty-hash", "solve_on_attempt": 2},
        {"name": "Source of Truth", "path": "source-of-truth", "solve_on_attempt": 3}
    ]

    print("=== Starting Talon CTF AI Test Harness (Benchmarking Mode) ===")
    telemetry_report = run_ai_test_harness(test_suite)

    print("\n=== Final AI Test Harness Telemetry Report ===")
    for report in telemetry_report:
        print(report)
